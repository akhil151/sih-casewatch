# NEXUS Supabase Configuration
# Required for live Supabase integration and authentication

# 1. Supabase Project URL (from Supabase Dashboard -> Project Settings -> API)
VITE_SUPABASE_URL=https://your-project-ref.supabase.co

# 2. Supabase Anonymous / Public API Key (from Supabase Dashboard -> Project Settings -> API)
# WARNING: NEVER place the service_role key here. Only the anon / public key is safe for browser use.
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key

# Optional alias for publishable key
# VITE_SUPABASE_PUBLISHABLE_KEY=your-supabase-anon-key

# 3. Application Server Settings
PORT=5173
BASE_PATH=/
